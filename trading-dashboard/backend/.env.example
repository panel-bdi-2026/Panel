# Conexion a Interactive Brokers (TWS o IB Gateway deben estar corriendo y accesibles
# desde donde se ejecuta este backend, con la API habilitada:
# TWS/IB Gateway -> Configure > API > Settings > "Enable ActiveX and Socket Clients").
#
# Puertos por defecto de IBKR:
#   TWS Paper Trading   -> 7497  (recomendado para empezar)
#   TWS Live            -> 7496
#   IB Gateway Paper    -> 4002
#   IB Gateway Live     -> 4001
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17

# "paper" (recomendado) o "live".
# Para usar "live" debes ADEMAS definir LIVE_CONFIRM tal cual abajo. Es intencional:
# evita que el modo live se active por accidente con un simple cambio de variable.
TRADING_MODE=paper
# LIVE_CONFIRM=I-UNDERSTAND-THIS-USES-REAL-MONEY

# Clave requerida en el header X-API-Key para cualquier accion que mueva dinero
# (enviar ordenes, aprobar/rechazar pendientes, cambiar reglas, pausar/reanudar trading).
API_KEY=cambia-esta-clave

RULES_PATH=rules.yaml
AUDIT_DB_PATH=audit.db
POLL_INTERVAL_SECONDS=5
