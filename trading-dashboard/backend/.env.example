# Conexion a Interactive Brokers (TWS o IB Gateway deben estar corriendo y accesibles
# desde donde se ejecuta este backend, con la API habilitada:
# TWS/IB Gateway -> Configure > API > Settings > "Enable ActiveX and Socket Clients").
#
# Puertos por defecto de IBKR:
#   TWS Paper Trading   -> 7497  (recomendado para empezar)
#   TWS Live            -> 7496
#   IB Gateway Paper    -> 4002
#   IB Gateway Live     -> 4001
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17

# "paper" (recomendado) o "live".
# Para usar "live" debes ADEMAS definir LIVE_CONFIRM tal cual abajo. Es intencional:
# evita que el modo live se active por accidente con un simple cambio de variable.
TRADING_MODE=paper
# LIVE_CONFIRM=I-UNDERSTAND-THIS-USES-REAL-MONEY

# Puertos para cambiar entre paper y live desde el boton del dashboard (sin
# reiniciar el backend). Si los dejas comentados, se usan los valores por
# defecto de TWS (7497 paper / 7496 live). Si usas IB Gateway, son 4002/4001.
# IB_PORT_LIVE solo es necesario una vez que definiste LIVE_CONFIRM arriba.
# IB_PORT_PAPER=7497
# IB_PORT_LIVE=7496

# Clave requerida en el header X-API-Key para cualquier accion que mueva dinero
# (enviar ordenes, aprobar/rechazar pendientes, cambiar reglas, pausar/reanudar
# trading) y tambien para leer cuenta/posiciones/auditoria y para escanear o
# correr el backtest (operaciones que consumen la cuota de la API de datos).
API_KEY=cambia-esta-clave

# Origenes permitidos para CORS. Dejalo vacio (o sin definir) si accedes al
# dashboard desde el mismo backend que sirve el frontend (caso normal): asi no
# se habilita CORS y ninguna web externa puede pegarle a la API. Solo defini
# esto (origenes separados por coma) si servis el frontend desde otro origen.
# ALLOWED_ORIGINS=http://localhost:5173

RULES_PATH=rules.yaml
SCREENER_PATH=screener.yaml
AUDIT_DB_PATH=audit.db
STATE_PATH=state.json
POLL_INTERVAL_SECONDS=5
