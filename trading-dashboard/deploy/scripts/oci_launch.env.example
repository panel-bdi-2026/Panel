# Configuracion para oci_launch_retry.sh. Copia este archivo a
# "oci_launch.env" (mismo directorio) y completa los valores con los OCID de tu
# tenancy. NO subas tu oci_launch.env a git: contiene identificadores de tu
# cuenta (esta ignorado en .gitignore). Las credenciales de API NO van aca:
# salen de ~/.oci/config (generado por `oci setup config`).

# --- Obligatorios -----------------------------------------------------------

# Compartment donde crear la VM. El root tenancy sirve para empezar.
#   oci iam compartment list --all --query 'data[].{name:name,id:id}' --output table
OCI_COMPARTMENT_ID="ocid1.tenancy.oc1..xxxxx"

# Availability domain. Es el NOMBRE completo, no solo "AD-1".
#   oci iam availability-domain list --query 'data[].name' --output table
OCI_AVAILABILITY_DOMAIN="abcd:US-ASHBURN-1-AD-1"

# Subnet PUBLICA donde va la VM (la que ya tenes en tu VCN).
#   oci network subnet list --compartment-id <compartment> --vcn-id <vcn> \
#     --query 'data[].{name:"display-name",id:id}' --output table
OCI_SUBNET_ID="ocid1.subnet.oc1..xxxxx"

# Imagen de Ubuntu para la shape ARM. Toma el primer OCID de:
#   oci compute image list --compartment-id <compartment> \
#     --operating-system "Canonical Ubuntu" --operating-system-version "22.04" \
#     --shape VM.Standard.A1.Flex --query 'data[0].id' --raw-output
OCI_IMAGE_ID="ocid1.image.oc1..xxxxx"

# Ruta a tu clave SSH PUBLICA (la .pub). Si no tenes uuna:
#   ssh-keygen -t ed25519 -f ~/.ssh/oci_panel   (guarda bien la privada)
OCI_SSH_PUBKEY_FILE="$HOME/.ssh/oci_panel.pub"

# --- Opcionales (con defaults razonables) -----------------------------------

OCI_SHAPE="VM.Standard.A1.Flex"
OCI_OCPUS="1"            # pedir menos OCPU/RAM entra mas facil cuando hay poca capacidad
OCI_MEMORY_GB="6"
OCI_DISPLAY_NAME="panel-trading"
OCI_ASSIGN_PUBLIC_IP="true"

RETRY_DELAY="60"         # segundos entre reintentos cuando no hay capacidad
RATE_DELAY="120"         # espera inicial tras un "Too many requests" (sube sola)
MAX_RATE_DELAY="900"     # tope del backoff de rate (15 min)
MAX_ATTEMPTS="0"         # 0 = reintentar para siempre hasta que entre o Ctrl-C
